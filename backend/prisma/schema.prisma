// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  name      String
  role      Role     @default(USER)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  profiles    Profile[]
  watchlist   WatchlistItem[]
  favorites   FavoriteItem[]
  watchHistory WatchHistory[]
  analytics   UserAnalytics[]

  @@map("users")
}

model Profile {
  id        String   @id @default(cuid())
  name      String
  avatar    String?
  userId    String
  isKid     Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user         User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  watchlist    WatchlistItem[]
  favorites    FavoriteItem[]
  watchHistory WatchHistory[]

  @@map("profiles")
}

model Content {
  id          String      @id @default(cuid())
  title       String
  description String?
  type        ContentType
  genre       String
  releaseYear Int
  duration    Int?        // in minutes
  posterUrl   String?
  backdropUrl String?
  videoUrl    String
  videoType   VideoType   // hls or dash
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  seasons      Season[]
  episodes     Episode[]
  watchlist    WatchlistItem[]
  favorites    FavoriteItem[]
  watchHistory WatchHistory[]

  @@map("content")
}

model Season {
  id        String   @id @default(cuid())
  number    Int
  title     String
  contentId String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  content  Content   @relation(fields: [contentId], references: [id], onDelete: Cascade)
  episodes Episode[]

  @@map("seasons")
}

model Episode {
  id          String   @id @default(cuid())
  number      Int
  title       String
  description String?
  duration    Int      // in minutes
  videoUrl    String
  videoType   VideoType
  seasonId    String?
  contentId   String   // for movies or standalone content
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  season       Season?        @relation(fields: [seasonId], references: [id], onDelete: Cascade)
  content      Content        @relation(fields: [contentId], references: [id], onDelete: Cascade)
  watchHistory WatchHistory[]

  @@map("episodes")
}

model WatchlistItem {
  id        String   @id @default(cuid())
  userId    String
  profileId String?
  contentId String
  createdAt DateTime @default(now())

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  profile Profile? @relation(fields: [profileId], references: [id], onDelete: Cascade)
  content Content  @relation(fields: [contentId], references: [id], onDelete: Cascade)

  @@unique([userId, profileId, contentId])
  @@map("watchlist_items")
}

model FavoriteItem {
  id        String   @id @default(cuid())
  userId    String
  profileId String?
  contentId String
  createdAt DateTime @default(now())

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  profile Profile? @relation(fields: [profileId], references: [id], onDelete: Cascade)
  content Content  @relation(fields: [contentId], references: [id], onDelete: Cascade)

  @@unique([userId, profileId, contentId])
  @@map("favorite_items")
}

model WatchHistory {
  id         String   @id @default(cuid())
  userId     String
  profileId  String?
  contentId  String
  episodeId  String?
  progress   Float    @default(0) // 0-1 representing percentage watched
  watchedAt  DateTime @default(now())
  completed  Boolean  @default(false)

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  profile Profile? @relation(fields: [profileId], references: [id], onDelete: Cascade)
  content Content  @relation(fields: [contentId], references: [id], onDelete: Cascade)
  episode Episode? @relation(fields: [episodeId], references: [id], onDelete: Cascade)

  @@unique([userId, profileId, contentId, episodeId])
  @@map("watch_history")
}

model UserAnalytics {
  id             String   @id @default(cuid())
  userId         String
  event          String   // login, video_play, video_pause, etc.
  metadata       String?  // JSON string for additional data
  timestamp      DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_analytics")
}

enum Role {
  USER
  ADMIN
}

enum ContentType {
  MOVIE
  SERIES
  CHANNEL
}

enum VideoType {
  HLS
  DASH
}